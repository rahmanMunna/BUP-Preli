# ---- HTTP ----
PORT=3000

# ---- LLM (directive interpretation) ----
# Primary provider: Google Gemini.
# Note: the challenge brief names gemini-2.0-flash, which Google has retired —
# the API answers 404 and points at gemini-3.6-flash. Change it here if the
# organisers pin a different model.
GEMINI_API_KEY=
# flash-lite answers in ~2s and the heavier flash tier is often rate limited;
# swap to gemini-3.6-flash if you want the stronger model as primary.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Fallback provider: OpenRouter, used only when Gemini fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
# Caps the answer size. OpenRouter otherwise reserves the model's whole context
# window up front and rejects the call (402) on a low-credit account.
LLM_MAX_OUTPUT_TOKENS=4096
# Order the providers are tried in; swap to "openrouter,gemini" to make the
# fallback primary without a code change.
LLM_PROVIDER_ORDER=gemini,openrouter

# ---- Python optimizer service ----
OPTIMIZER_URL=http://localhost:8000
OPTIMIZER_PATH=/solve
OPTIMIZER_TIMEOUT_MS=20000
OPTIMIZER_MAX_RETRIES=2
# When true, an unreachable optimizer falls back to the built-in heuristic
# dispatcher instead of returning 503.
OPTIMIZER_FALLBACK_ENABLED=true
